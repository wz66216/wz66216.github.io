---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/utils';

const lang = 'en' as const;
const sections = [
  ['quant.themes.title', 'quant.themes.body'],
  ['quant.method.title', 'quant.method.body'],
  ['quant.scope.title', 'quant.scope.body'],
  ['quant.disclaimer.title', 'quant.disclaimer.body'],
] as const;
---

<BaseLayout title="Quantitative Finance | Wang Zhai" description={t(lang, 'quant.intro')} lang={lang}>
  <div class="quant-page">
    <header>
      <span class="piece" aria-hidden="true">♜</span>
      <h1>{t(lang, 'quant.page.title')}</h1>
      <p>{t(lang, 'quant.intro')}</p>
    </header>

    <div class="chessboard-divider" role="separator"></div>

    <div class="quant-grid">
      {sections.map(([title, body], index) => (
        <section class="quant-card">
          <span class="coordinate">Q{index + 1}</span>
          <h2>{t(lang, title)}</h2>
          <p>{t(lang, body)}</p>
        </section>
      ))}
    </div>
  </div>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .quant-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
  }

  header {
    max-width: 820px;
  }

  .piece {
    display: block;
    font-size: 4rem;
    line-height: 1;
    margin-bottom: var(--space-md);
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    margin-bottom: var(--space-md);
  }

  header p,
  .quant-card p {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .quant-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--color-border);
  }

  .quant-card {
    min-height: 250px;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
  }

  .coordinate {
    font-family: var(--font-code);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
  }

  h2 {
    font-size: 1.3rem;
    margin: var(--space-xl) 0 var(--space-md);
  }

  @media (max-width: 768px) {
    .quant-page {
      padding: var(--space-xl) var(--space-md);
    }

    .quant-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
